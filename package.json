{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "npm run typecheck && npm run build -w @workspace/learnease-mirpur",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run typecheck --workspaces --if-present",
    "dev": "npm run dev -w @workspace/learnease-mirpur",
    "postinstall": "node scripts/patch-wrangler.cjs"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "glob": "^13.0.6",
    "js-yaml": "^5.2.1"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "typescript": "~5.9.3",
    "wrangler": "^4.112.0"
  },
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ]
}